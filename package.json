{
  "name": "fpv-analytics",
  "description": "Analyse de vols FPV long range : trace GPS 3D, batterie, liaison radio et vidéo",
  "scripts": {
    "dev": "npm run ocr-assets && vite",
    "build": "npm run ocr-assets && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "assets": "capacitor-assets generate --android --iconBackgroundColor \"#0b1220\" --iconBackgroundColorDark \"#0b1220\" --splashBackgroundColor \"#0b1220\" --splashBackgroundColorDark \"#0b1220\"",
    "version": "node scripts/version.mjs",
    "ocr-assets": "node scripts/copy-ocr-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harantol/fpv_analytics.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/harantol/fpv_analytics/issues"
  },
  "homepage": "https://github.com/harantol/fpv_analytics#readme",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.4.6",
    "idb-keyval": "^6.3.0",
    "maplibre-gl": "^5.24.0",
    "mp4box": "^2.4.1",
    "tesseract.js": "^7.0.0",
    "uplot": "^1.6.32",
    "wasm-feature-detect": "^1.9.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module"
}
